---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 - Seiya Nuta">
  <div class="min-h-screen flex mt-16">
    <div class="text-center">
      <h1 class="text-6xl font-bold text-gray-900 dark:text-gray-100 mb-4">
        404
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-8">
        Page not found - if you think it's a dead link, let me know.
      </p>
      <a href="/" class="text-blue-600 dark:text-blue-400 hover:underline">
        <span class="text-2xl font-medium">Back to Home</span>
      </a>
    </div>
  </div>
</BaseLayout>
